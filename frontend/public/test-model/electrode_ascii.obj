# WaveFront OBJ - L-shaped electrode (ASCII, color test)
# Materials: Steel body, Black coating, Yellow paint, White LED tip
mtllib test_electrode.mtl

# ── Shared normals ───────────────────────────────────────────────
vn  0.0  1.0  0.0
vn  0.0 -1.0  0.0
vn  0.0  0.0  1.0
vn  0.0  0.0 -1.0
vn  1.0  0.0  0.0
vn -1.0  0.0  0.0

# ════════════════════════════════════════════════════════════════
# Part 1 — VERTICAL SHAFT  (Steel_-_Satin, grey)
# Box: x[-0.15,0.15]  y[0,4.0]  z[-0.15,0.15]
# ════════════════════════════════════════════════════════════════
o Vertical_Shaft
usemtl Steel_-_Satin

v -0.15 0.00 -0.15
v  0.15 0.00 -0.15
v  0.15 0.00  0.15
v -0.15 0.00  0.15
v -0.15 4.00 -0.15
v  0.15 4.00 -0.15
v  0.15 4.00  0.15
v -0.15 4.00  0.15

# bottom
f 1//2 4//2 3//2 2//2
# top
f 5//1 6//1 7//1 8//1
# front (+z)
f 4//3 8//3 7//3 3//3
# back  (-z)
f 1//4 2//4 6//4 5//4
# right (+x)
f 2//5 3//5 7//5 6//5
# left  (-x)
f 1//6 5//6 8//6 4//6

# ════════════════════════════════════════════════════════════════
# Part 2 — HORIZONTAL ARM  (Coating_-_Black_Oxide, dark)
# Box: x[0.15,1.8]  y[3.5,4.0]  z[-0.15,0.15]
# ════════════════════════════════════════════════════════════════
o Horizontal_Arm
usemtl Coating_-_Black_Oxide

v  0.15 3.50 -0.15
v  1.80 3.50 -0.15
v  1.80 3.50  0.15
v  0.15 3.50  0.15
v  0.15 4.00 -0.15
v  1.80 4.00 -0.15
v  1.80 4.00  0.15
v  0.15 4.00  0.15

# bottom
f 9//2  12//2 11//2 10//2
# top
f 13//1 14//1 15//1 16//1
# front (+z)
f 12//3 16//3 15//3 11//3
# back  (-z)
f  9//4 10//4 14//4 13//4
# right (+x)
f 10//5 11//5 15//5 14//5
# left  (-x)
f  9//6 13//6 16//6 12//6

# ════════════════════════════════════════════════════════════════
# Part 3 — HANDLE BAND  (Paint_-_Metallic_(Yellow), gold)
# Box: x[-0.2,0.2]  y[0,0.6]  z[-0.2,0.2]
# ════════════════════════════════════════════════════════════════
o Handle_Band
usemtl Paint_-_Metallic_(Yellow)

v -0.20 0.00 -0.20
v  0.20 0.00 -0.20
v  0.20 0.00  0.20
v -0.20 0.00  0.20
v -0.20 0.60 -0.20
v  0.20 0.60 -0.20
v  0.20 0.60  0.20
v -0.20 0.60  0.20

# bottom
f 17//2 20//2 19//2 18//2
# top
f 21//1 22//1 23//1 24//1
# front
f 20//3 24//3 23//3 19//3
# back
f 17//4 18//4 22//4 21//4
# right
f 18//5 19//5 23//5 22//5
# left
f 17//6 21//6 24//6 20//6

# ════════════════════════════════════════════════════════════════
# Part 4 — ELECTRODE TIP  (LED_-_SMD_3528_-_8lm_(White), white)
# Box: x[1.65,1.85]  y[3.4,3.65]  z[-0.10,0.10]
# ════════════════════════════════════════════════════════════════
o Electrode_Tip
usemtl LED_-_SMD_3528_-_8lm_(White)

v  1.65 3.40 -0.10
v  1.85 3.40 -0.10
v  1.85 3.40  0.10
v  1.65 3.40  0.10
v  1.65 3.65 -0.10
v  1.85 3.65 -0.10
v  1.85 3.65  0.10
v  1.65 3.65  0.10

# bottom
f 25//2 28//2 27//2 26//2
# top
f 29//1 30//1 31//1 32//1
# front
f 28//3 32//3 31//3 27//3
# back
f 25//4 26//4 30//4 29//4
# right
f 26//5 27//5 31//5 30//5
# left
f 25//6 29//6 32//6 28//6

# test_electrode.obj
# 3-section electrode: RED handle, BLUE stem, GREEN tip
# Designed to clearly verify that OBJ+MTL color loading works.
mtllib test_electrode.mtl

# ── Shared normals (used by all three objects) ───────────────────────────────
vn  0  1  0
vn  0 -1  0
vn  0  0  1
vn  0  0 -1
vn  1  0  0
vn -1  0  0

# ── HANDLE — wide base, RED ──────────────────────────────────────────────────
o Handle
v -0.30  0.00 -0.30
v  0.30  0.00 -0.30
v  0.30  0.00  0.30
v -0.30  0.00  0.30
v -0.30  1.20 -0.30
v  0.30  1.20 -0.30
v  0.30  1.20  0.30
v -0.30  1.20  0.30
usemtl Bright_Red
f  1//2  4//2  3//2  2//2
f  5//1  6//1  7//1  8//1
f  1//4  2//4  6//4  5//4
f  3//3  4//3  8//3  7//3
f  2//5  3//5  7//5  6//5
f  4//6  1//6  5//6  8//6

# ── STEM — narrow middle, BLUE ───────────────────────────────────────────────
o Stem
v -0.15  1.20 -0.15
v  0.15  1.20 -0.15
v  0.15  1.20  0.15
v -0.15  1.20  0.15
v -0.15  3.50 -0.15
v  0.15  3.50 -0.15
v  0.15  3.50  0.15
v -0.15  3.50  0.15
usemtl Bright_Blue
f  9//2 12//2 11//2 10//2
f 13//1 14//1 15//1 16//1
f  9//4 10//4 14//4 13//4
f 11//3 12//3 16//3 15//3
f 10//5 11//5 15//5 14//5
f 12//6  9//6 13//6 16//6

# ── TIP — thin electrode end, GREEN ─────────────────────────────────────────
o Tip
v -0.08  3.50 -0.08
v  0.08  3.50 -0.08
v  0.08  3.50  0.08
v -0.08  3.50  0.08
v -0.08  4.20 -0.08
v  0.08  4.20 -0.08
v  0.08  4.20  0.08
v -0.08  4.20  0.08
usemtl Bright_Green
f 17//2 20//2 19//2 18//2
f 21//1 22//1 23//1 24//1
f 17//4 18//4 22//4 21//4
f 19//3 20//3 24//3 23//3
f 18//5 19//5 23//5 22//5
f 20//6 17//6 21//6 24//6
